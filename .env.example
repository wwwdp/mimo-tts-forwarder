# MiMO TTS Forwarder Configuration
# Version: 1.0.0
# Copy this to .env and fill in your values

# Required: Your MiMo API Key
# Register at: https://platform.xiaomimimo.com
MIMO_API_KEY=

# MiMo API Base URL (default: Xiaomi official endpoint)
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# Server host and port
HOST=0.0.0.0
PORT=8765

# Optional: Access token for API protection
# If set, requests must include Authorization: Bearer <TOKEN>
# Or add ?token=<TOKEN> to GET requests
TOKEN=

# Max audio file size for voice cloning upload (MB)
MAX_AUDIO_SIZE_MB=10

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
